[resource]
script = ExtResource("1_jc2it")
card_texture = ExtResource("1_ead84")
name = "孤注一掷"
id = 25
is_sub_card = true
effect_description = "使用效果：在行动后将场上所有卡牌丢入弃牌堆，玩家同时抽取一张牌（如若为法术卡则将重新抽取）通过对比卡牌生命值上限大小来决定胜利。"
notes = "获得条件：累积击杀五张战斗卡，其牌库中仅剩一张牌（累计击杀超过五张或者牌库牌数多于一时无效）。"
